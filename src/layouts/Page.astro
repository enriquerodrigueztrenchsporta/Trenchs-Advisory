---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Textos del bloque de cierre, para que no se repita igual en cada página. */
  closing?: { kicker?: string; title?: string; text?: string };
}
const { title, description, closing = {} } = Astro.props;
---
<Base title={title} description={description}>
  <Header />
  <main>
    <slot />
  </main>
  <Closing {...closing} />
  <Footer />
</Base>
