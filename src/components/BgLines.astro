---
// Fondo de líneas curvas que repiten el corte del logo. Muy tenue y con deriva lenta.
interface Props {
  tone?: 'dark' | 'light';
  side?: 'left' | 'right';
}
const { tone = 'dark', side = 'right' } = Astro.props;
const offsets = [0, 34, 68, 102, 136, 170, 204];
---
<div class:list={['bg-lines', `bg-lines--${tone}`, `bg-lines--${side}`]} aria-hidden="true">
  <svg viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {offsets.map((o, i) => (
      <path
        d={`M${160 + o} -20 C${160 + o} 160 ${200 + o} 300 ${250 + o} 480 C${290 + o} 620 ${300 + o} 760 ${296 + o} 920`}
        style={`--i:${i}`}
      />
    ))}
  </svg>
</div>

<style>
  .bg-lines {
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(60vw, 820px);
    pointer-events: none;
    z-index: 0;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
  }
  .bg-lines--right {
    right: -6vw;
  }
  .bg-lines--left {
    left: -6vw;
    transform: scaleX(-1);
  }
  .bg-lines svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .bg-lines path {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    animation: sway 26s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -2.5s);
  }
  .bg-lines--dark path {
    stroke: rgb(31 58 51 / 0.12);
  }
  .bg-lines--light path {
    stroke: rgb(212 183 120 / 0.14);
  }
  .bg-lines path:nth-child(4) {
    stroke-width: 1.4;
  }
  .bg-lines--dark path:nth-child(4) {
    stroke: rgb(176 138 62 / 0.28);
  }
  @keyframes sway {
    from {
      transform: translateX(-18px);
    }
    to {
      transform: translateX(22px);
    }
  }
</style>
