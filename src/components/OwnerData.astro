---
// Ficha del titular para las páginas legales. Solo muestra los datos rellenos en src/data/legal.ts.
import { OWNER } from '../data/legal';

const rows: [string, string][] = [
  ['Titular', OWNER.name],
  ['Nombre comercial', OWNER.tradeName],
  ['NIF', OWNER.taxId],
  ['Domicilio', OWNER.address],
  ['Datos registrales', OWNER.type === 'sociedad' ? OWNER.registry : ''],
].filter(([, value]) => value.trim()) as [string, string][];
---
<dl>
  {rows.map(([label, value]) => (
    <>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </>
  ))}
  <dt>Correo electrónico</dt>
  <dd><a href={`mailto:${OWNER.email}`}>{OWNER.email}</a></dd>
  {OWNER.phone.trim() && (
    <>
      <dt>Teléfono</dt>
      <dd><a href={`tel:${OWNER.phone.replace(/\s/g, '')}`}>{OWNER.phone}</a></dd>
    </>
  )}
</dl>
