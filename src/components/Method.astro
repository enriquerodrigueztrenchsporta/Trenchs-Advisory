---
import { url } from '../consts';

// Versión resumida del método para la portada; el detalle está en MethodDetail.
interface Props {
  num?: string;
}
const { num } = Astro.props;

const phases = [
  { name: 'Diagnóstico', goal: 'Entender el negocio, las decisiones críticas y el estado real de la información.' },
  { name: 'Diseño', goal: 'Definir indicadores, modelo de datos y solución objetivo.' },
  { name: 'Construcción', goal: 'Desarrollar el modelo, el cuadro de mando o la automatización.' },
  { name: 'Adopción', goal: 'Formar, acompañar y consolidar el cambio de hábito.' },
  { name: 'Mejora continua', goal: 'Revisar, ampliar y ajustar con el negocio en marcha.' },
];
---
<section class="section section--follow method has-bg bg-grid" style="--grid-x:85%; --grid-y:30%" id="metodo">
  <div class="container">
    <p class="eyebrow" data-reveal>{num && <span class="eyebrow__num">{num}</span>} Método</p>
    <div class="method__intro">
      <h2 class="display" data-reveal>Ningún proyecto termina en un informe.</h2>
      <div data-reveal style="--d:1">
        <p class="lead">
          Termina en una decisión tomada y un proceso funcionando. El mismo método, sea cual sea el área de servicio.
        </p>
        <a class="text-link method__more" href={url('firma/metodo')}>
          Ver el método completo <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <ol class="phases" data-animate>
      <li class="phases__line" aria-hidden="true"></li>
      {phases.map((p, i) => (
        <li class="phase" style={`--i:${i}`}>
          <span class="phase__marker" aria-hidden="true">{i + 1}</span>
          <h3 class="phase__name">{p.name}</h3>
          <p class="phase__goal">{p.goal}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .method__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .method__more {
    margin-top: 1.5rem;
  }
  .phases {
    position: relative;
    list-style: none;
    margin: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .phases__line {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: calc(20% - 1.25rem);
    height: 1px;
    background: var(--green-900);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 2.2s var(--ease) 0.2s;
  }
  .phases.is-visible .phases__line {
    transform: scaleX(1);
  }
  .phase {
    position: relative;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(0.3s + var(--i) * 0.35s);
  }
  .phases.is-visible .phase {
    opacity: 1;
    transform: none;
  }
  .phase__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--cream-50);
    border: 1px solid var(--green-900);
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--green-900);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .phase__marker::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px solid var(--gold-500);
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .phase:hover .phase__marker {
    background: var(--green-900);
    color: var(--cream-50);
  }
  .phase:hover .phase__marker::after {
    opacity: 1;
    transform: none;
  }
  .phase__name {
    margin-top: 1.5rem;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 400;
  }
  .phase__goal {
    margin-top: 0.75rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .method__intro {
      grid-template-columns: 1fr;
    }
    .phases {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-left: 3.75rem;
    }
    .phases__line {
      top: 0;
      bottom: 0;
      left: 1.25rem;
      right: auto;
      width: 1px;
      height: auto;
      transform: scaleY(0);
      transform-origin: top;
    }
    .phases.is-visible .phases__line {
      transform: scaleY(1);
    }
    .phase__marker {
      position: absolute;
      left: -3.75rem;
      top: 0;
    }
    .phase__name {
      margin-top: 0.3rem;
    }
  }
</style>
