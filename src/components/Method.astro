---
import { url } from '../consts';

interface Props {
  num?: string;
  /** Versión resumida (portada y servicios): solo fases y enlace al método completo. */
  compact?: boolean;
}
const { num, compact = false } = Astro.props;

const phases = [
  { name: 'Diagnóstico', goal: 'Entender el negocio, las decisiones críticas y el estado real de la información.', result: 'Mapa de problemas priorizado y cuantificado' },
  { name: 'Diseño', goal: 'Definir indicadores, modelo de datos y solución objetivo.', result: 'Propuesta con alcance, plazo y retorno estimado' },
  { name: 'Construcción', goal: 'Desarrollar el modelo, el cuadro de mando o la automatización.', result: 'Solución en producción, documentada y trazable' },
  { name: 'Adopción', goal: 'Formar, acompañar y consolidar el cambio de hábito.', result: 'Uso real por parte del cliente, sin dependencia' },
  { name: 'Mejora continua', goal: 'Revisar, ampliar y ajustar con el negocio en marcha.', result: 'Relación recurrente y valor creciente' },
];
---
<section class:list={['section', 'method', 'has-bg', 'bg-grid', { 'method--compact': compact }]} style="--grid-x:85%; --grid-y:30%" id="metodo">
  <div class="container">
    <p class="eyebrow" data-reveal>{num && <span class="eyebrow__num">{num}</span>} Método</p>
    <div class="method__intro">
      <h2 class="display" data-reveal>Ningún proyecto termina en un informe.</h2>
      <div data-reveal style="--d:1">
        <p class="lead">
          Termina en una decisión tomada y un proceso funcionando. El mismo método, sea cual sea el área de servicio.
        </p>
        {compact && (
          <a class="text-link method__more" href={url('firma/metodo')}>
            Ver el método completo <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        )}
      </div>
    </div>

    <ol class="phases" data-animate>
      <li class="phases__line" aria-hidden="true"></li>
      {phases.map((p, i) => (
        <li class="phase" style={`--i:${i}`}>
          <span class="phase__marker" aria-hidden="true">{i + 1}</span>
          <h3 class="phase__name">{p.name}</h3>
          <p class="phase__goal">{p.goal}</p>
          {!compact && <p class="phase__result"><span>Resultado</span>{p.result}</p>}
        </li>
      ))}
    </ol>

    {!compact && (
      <div class="rules">
        <div class="rule" data-reveal>
          <span class="rule__tag">Regla 01</span>
          <p>Valor visible en las primeras semanas. Nunca esperar al final del proyecto.</p>
        </div>
        <div class="rule" data-reveal style="--d:1">
          <span class="rule__tag">Regla 02</span>
          <p>Dejar al cliente más capaz de lo que era, aunque eso reduzca su dependencia de nosotros.</p>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .method__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .method__more {
    margin-top: 1.5rem;
  }
  .phases {
    position: relative;
    list-style: none;
    margin: clamp(3.5rem, 7vw, 5.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .phases__line {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: calc(20% - 1.25rem);
    height: 1px;
    background: var(--green-900);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 2.2s var(--ease) 0.2s;
  }
  .phases.is-visible .phases__line {
    transform: scaleX(1);
  }
  .phase {
    position: relative;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.8s var(--ease),
      transform 0.8s var(--ease);
    transition-delay: calc(0.3s + var(--i) * 0.35s);
  }
  .phases.is-visible .phase {
    opacity: 1;
    transform: none;
  }
  .phase__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--cream-50);
    border: 1px solid var(--green-900);
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--green-900);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .phase__marker::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: 50%;
    border: 1px solid var(--gold-500);
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .phase:hover .phase__marker {
    background: var(--green-900);
    color: var(--cream-50);
  }
  .phase:hover .phase__marker::after {
    opacity: 1;
    transform: none;
  }
  .phase__name {
    margin-top: 1.5rem;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: 400;
  }
  .phase__goal {
    margin-top: 0.75rem;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }
  .phase__result {
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--ink);
  }
  .phase__result span {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-500);
  }

  .rules {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }
  .rule {
    padding: 1.75rem 2rem;
    border-left: 2px solid var(--gold-500);
    background: var(--cream-100);
  }
  .rule__tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .rule p {
    margin-top: 0.6rem;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.3;
  }

  @media (max-width: 960px) {
    .method__intro {
      grid-template-columns: 1fr;
    }
    .phases {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding-left: 3.75rem;
    }
    .phases__line {
      top: 0;
      bottom: 0;
      left: 1.25rem;
      right: auto;
      width: 1px;
      height: auto;
      transform: scaleY(0);
      transform-origin: top;
    }
    .phases.is-visible .phases__line {
      transform: scaleY(1);
    }
    .phase__marker {
      position: absolute;
      left: -3.75rem;
      top: 0;
    }
    .phase__name {
      margin-top: 0.3rem;
    }
    .rules {
      grid-template-columns: 1fr;
    }
  }
</style>
