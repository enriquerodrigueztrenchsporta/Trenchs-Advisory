---
import { DIAGNOSIS_MAILTO } from '../consts';

// Diagrama: cuatro fuentes que convergen, se ordenan y terminan en una decisión.
const W = 560;
const H = 440;
const sources = ['Datos', 'Finanzas', 'Operaciones', 'Mercado'];
const sourceY = [70, 170, 270, 370];
const bundleX0 = 250;
const bundleX1 = 380;
const decision = { x: 500, y: 220 };
const lines: { d: string; delay: number }[] = [];
let idx = 0;
sourceY.forEach((sy, k) => {
  for (let j = 0; j < 3; j++) {
    const y0 = sy + (j - 1) * 7;
    const by = 170 + idx * (100 / 11);
    const d = `M0 ${y0} C${110 + j * 12} ${y0} ${140 - j * 10} ${by.toFixed(1)} ${bundleX0} ${by.toFixed(1)} H${bundleX1} L${decision.x} ${decision.y}`;
    lines.push({ d, delay: k * 0.12 + j * 0.05 });
    idx++;
  }
});
const gridX = [bundleX0, bundleX0 + 43, bundleX0 + 86, bundleX1];
---
<section class="hero has-bg bg-grid" style="--grid-x:78%; --grid-y:55%">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__kicker" data-reveal>Consultoría de estrategia, finanzas, datos e IA</p>
      <h1 class="hero__title">
        <span class="hero__line"><span style="--i:0">Decisiones más</span></span>
        <span class="hero__line"><span style="--i:1">inteligentes.</span></span>
        <span class="hero__line"><span style="--i:2">Organizaciones</span></span>
        <span class="hero__line"><span style="--i:3">más competitivas.</span></span>
      </h1>
      <p class="lead hero__lead" data-reveal style="--d:5">
        Integramos estrategia, finanzas, datos y tecnología para que empresas y administraciones
        decidan con evidencia, anticipación y criterio económico.
      </p>
      <div class="hero__actions" data-reveal style="--d:6">
        <a class="btn" href={DIAGNOSIS_MAILTO}>
          Solicitar diagnóstico <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <span class="note">Sesión inicial sin coste</span>
      </div>
    </div>

    <figure class="flow" aria-label="Datos, finanzas, operaciones y mercado convergen en una decisión">
      <div class="flow__labels" aria-hidden="true">
        {sources.map((s, i) => (
          <span class="flow__label" style={`top:${(sourceY[i] / H) * 100}%; --i:${i}`}>{s}</span>
        ))}
      </div>
      <svg class="flow__svg" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
        <g class="flow__grid">
          {gridX.map((x) => <line x1={x} x2={x} y1="150" y2="290" />)}
        </g>
        <g class="flow__lines">
          {lines.map((l) => <path d={l.d} pathLength="1" style={`--delay:${l.delay}s`} />)}
        </g>
        <g class="flow__pulses">
          {lines.map((l, i) => <path d={l.d} pathLength="1" style={`--delay:${2.4 + ((i * 7) % 12) * 0.38}s`} />)}
        </g>
        <line class="flow__out" x1={decision.x} y1={decision.y} x2={W} y2={decision.y} pathLength="1" />
        <circle class="flow__ring" cx={decision.x} cy={decision.y} r="7" />
        <rect class="flow__node" x={decision.x - 6} y={decision.y - 6} width="12" height="12" />
      </svg>
      <span class="flow__decision" style={`left:${(decision.x / W) * 100}%; top:${((decision.y + 30) / H) * 100}%`}>Decisión</span>
    </figure>
  </div>
  <a class="hero__scroll" href="#enfoque" aria-label="Ir al contenido">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 8rem 5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .hero__kicker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-600);
    margin-bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hero__kicker::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: var(--gold-500);
  }
  .hero__title {
    font-size: clamp(2.6rem, 4.4vw, 4.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero__line > span {
    display: inline-block;
    animation: rise 1.1s var(--ease) both;
    animation-delay: calc(0.15s + var(--i) * 0.11s);
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  .hero__lead {
    margin-top: 2rem;
  }
  .hero__actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* Diagrama */
  .flow {
    position: relative;
    margin: 0;
    padding-left: 7.5rem;
  }
  .flow__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .flow__labels {
    position: absolute;
    inset: 0 auto 0 0;
    width: 7.5rem;
  }
  .flow__label,
  .flow__decision {
    position: absolute;
    transform: translateY(-50%);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    animation: fade 1s var(--ease) both;
    animation-delay: calc(0.4s + var(--i, 0) * 0.12s);
  }
  .flow__decision {
    transform: translateX(-50%);
    color: var(--green-900);
    font-weight: 600;
    animation-delay: 2.1s;
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .flow__grid line {
    stroke: var(--line);
    stroke-width: 1;
    animation: fade 1.2s var(--ease) both 1.1s;
  }
  .flow__lines path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
    opacity: 0.55;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2s var(--ease) forwards;
    animation-delay: calc(0.5s + var(--delay));
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .flow__pulses path {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 0.07 1.2;
    stroke-dashoffset: 0.07;
    opacity: 0;
    animation: pulse 4.6s cubic-bezier(0.45, 0, 0.25, 1) infinite;
    animation-delay: var(--delay);
  }
  @keyframes pulse {
    0% {
      stroke-dashoffset: 0.07;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    70% {
      stroke-dashoffset: -0.95;
      opacity: 1;
    }
    76%,
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }
  .flow__out {
    stroke: var(--green-900);
    stroke-width: 1.4;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.9s var(--ease) forwards 2.2s;
  }
  .flow__node {
    fill: var(--green-900);
    transform-box: fill-box;
    transform-origin: center;
    animation: pop 0.7s var(--ease) both 2s;
  }
  @keyframes pop {
    from {
      transform: scale(0);
    }
  }
  .flow__ring {
    fill: none;
    stroke: var(--gold-500);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: ring 2.8s var(--ease) infinite 2.8s;
  }
  @keyframes ring {
    0% {
      transform: scale(1);
      opacity: 0.9;
    }
    100% {
      transform: scale(4.5);
      opacity: 0;
    }
  }

  .hero__scroll {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 2rem;
    width: 1px;
    height: 3.5rem;
    background: var(--line);
    overflow: hidden;
  }
  .hero__scroll span {
    position: absolute;
    inset: 0;
    background: var(--green-900);
    animation: scrollcue 2.4s var(--ease) infinite 3s;
    transform: translateY(-100%);
  }
  @keyframes scrollcue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding-block: 8rem 6rem;
    }
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .flow {
      padding-left: 5.75rem;
      margin-top: 1rem;
    }
    .flow__labels {
      width: 5.75rem;
    }
    .flow__label,
    .flow__decision {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }
    .hero__scroll {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__pulses,
    .flow__ring {
      display: none;
    }
  }
</style>
