---
// Cabecera de páginas interiores: retícula de fondo y el símbolo del logo en marca de agua.
import LogoMark from './LogoMark.astro';

interface Props {
  kicker: string;
  title: string;
  lead?: string;
}
const { kicker, title, lead } = Astro.props;
---
<section class="phero has-bg bg-grid" style="--grid-x:80%; --grid-y:50%">
  <LogoMark class="phero__mark" mono />
  <div class="container phero__inner">
    <p class="phero__kicker" data-reveal>{kicker}</p>
    <h1 class="phero__title">
      <span class="phero__line"><span>{title}</span></span>
    </h1>
    {lead && <p class="lead phero__lead" data-reveal style="--d:3">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(10rem, 18vw, 13rem) clamp(4.5rem, 8vw, 7rem);
    border-bottom: 1px solid var(--line);
  }
  .phero :global(.phero__mark) {
    position: absolute;
    right: max(var(--gutter), calc((100vw - var(--maxw)) / 2 + var(--gutter)));
    top: 58%;
    width: clamp(14rem, 26vw, 24rem);
    height: auto;
    color: var(--green-900);
    opacity: 0.055;
    transform: translateY(-50%);
    animation:
      mark-in 2.2s var(--ease) both,
      mark-float 12s ease-in-out infinite alternate 2.2s;
    pointer-events: none;
  }
  @keyframes mark-in {
    from {
      opacity: 0;
      transform: translateY(-44%) scale(0.94);
    }
  }
  @keyframes mark-float {
    from {
      transform: translateY(-50%);
    }
    to {
      transform: translateY(-54%);
    }
  }
  @media (max-width: 760px) {
    .phero :global(.phero__mark) {
      right: -2.5rem;
      top: auto;
      bottom: -3rem;
      width: 11rem;
      transform: none;
      animation: none;
      opacity: 0.045;
    }
  }
  .phero__kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--green-600);
  }
  .phero__kicker::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: var(--gold-500);
  }
  .phero__title {
    margin-top: 1.75rem;
    max-width: 56rem;
    font-size: clamp(2.6rem, 6vw, 5.25rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .phero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
  }
  .phero__line > span {
    display: inline-block;
    animation: phero-rise 1.1s var(--ease) both 0.15s;
  }
  @keyframes phero-rise {
    from {
      transform: translateY(105%);
    }
  }
  .phero__lead {
    margin-top: 2rem;
    max-width: 42rem;
  }
</style>
