---
// Método completo en vertical: cada fase con objetivo y resultado; la línea se rellena con el scroll.
interface Props {
  num?: string;
}
const { num } = Astro.props;

const phases = [
  { name: 'Diagnóstico', goal: 'Entender el negocio, las decisiones críticas y el estado real de la información.', result: 'Mapa de problemas priorizado y cuantificado' },
  { name: 'Diseño', goal: 'Definir indicadores, modelo de datos y solución objetivo.', result: 'Propuesta con alcance, plazo y retorno estimado' },
  { name: 'Construcción', goal: 'Desarrollar el modelo, el cuadro de mando o la automatización.', result: 'Solución en producción, documentada y trazable' },
  { name: 'Adopción', goal: 'Formar, acompañar y consolidar el cambio de hábito.', result: 'Uso real por parte del cliente, sin dependencia' },
  { name: 'Mejora continua', goal: 'Revisar, ampliar y ajustar con el negocio en marcha.', result: 'Relación recurrente y valor creciente' },
];
---
<section class="section mdetail" data-mdetail>
  <div class="container mdetail__grid">
    <div class="mdetail__head">
      <p class="eyebrow" data-reveal>{num && <span class="eyebrow__num">{num}</span>} Las cinco fases</p>
      <h2 class="display" data-reveal>Cada fase termina con algo tangible.</h2>
      <div class="rules">
        <p class="rule" data-reveal style="--d:1">
          <span>Regla 01</span>Valor visible en las primeras semanas. Nunca esperar al final del proyecto.
        </p>
        <p class="rule" data-reveal style="--d:2">
          <span>Regla 02</span>Dejar al cliente más capaz de lo que era, aunque eso reduzca su dependencia de nosotros.
        </p>
      </div>
    </div>

    <ol class="steps">
      <li class="steps__rail" aria-hidden="true"><span></span></li>
      {phases.map((p, i) => (
        <li class="step" data-step>
          <span class="step__num">0{i + 1}</span>
          <div class="step__body">
            <h3>{p.name}</h3>
            <p class="step__goal">{p.goal}</p>
            <p class="step__result">{p.result}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-mdetail]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('.steps')!;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const update = () => {
      const r = list.getBoundingClientRect();
      const mid = window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      list.style.setProperty('--progress', p.toFixed(3));
      steps.forEach((s) => s.classList.toggle('is-on', s.getBoundingClientRect().top < mid));
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
  });
</script>

<style>
  .mdetail__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }
  .mdetail__head {
    position: sticky;
    top: 7rem;
  }
  .mdetail__head h2 {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .rules {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }
  .rule {
    padding: 1.25rem 1.5rem;
    border-left: 2px solid var(--gold-500);
    background: var(--cream-100);
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .rule span {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .steps {
    --progress: 0;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .steps__rail {
    position: absolute;
    left: 2.25rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--line);
  }
  .steps__rail span {
    position: absolute;
    inset: 0;
    background: var(--gold-500);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.5rem;
    padding-bottom: 3.5rem;
  }
  .step__num {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--cream-50);
    border: 1px solid var(--line);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 300;
    color: var(--ink-mute);
    transition:
      background-color 0.6s var(--ease),
      border-color 0.6s var(--ease),
      color 0.6s var(--ease);
  }
  .step__body {
    padding-top: 0.9rem;
    opacity: 0.35;
    transform: translateX(10px);
    transition:
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .step h3 {
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    font-weight: 350;
  }
  .step__goal {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }
  .step__result {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 0.9rem;
    background: var(--cream-100);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green-900);
  }
  .step.is-on .step__num {
    background: var(--green-900);
    border-color: var(--green-900);
    color: var(--cream-50);
  }
  .step.is-on .step__body {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 960px) {
    .mdetail__grid {
      grid-template-columns: 1fr;
    }
    .mdetail__head {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .step {
      grid-template-columns: 3rem 1fr;
      gap: 1rem;
    }
    .step__num {
      width: 3rem;
      height: 3rem;
      font-size: 1.2rem;
    }
    .steps__rail {
      left: 1.5rem;
    }
    .step__body {
      padding-top: 0.4rem;
    }
  }
</style>
