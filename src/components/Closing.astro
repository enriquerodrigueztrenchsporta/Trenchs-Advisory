---
import { DIAGNOSIS_MAILTO, EMAIL, url } from '../consts';
import { holder } from '../data/legal';

interface Props {
  kicker?: string;
  title?: string;
  text?: string;
}
const {
  kicker = 'Primer paso',
  title = 'Hablemos de la decisión que hoy le quita más tiempo.',
  text = 'Una primera conversación para entender su organización, sus decisiones críticas y el estado real de su información.',
} = Astro.props;
---
<section class="closing">
  <div class="container closing__inner">
    <svg class="closing__lines" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
      {Array.from({ length: 9 }, (_, i) => (
        <path d={`M0 ${40 + i * 40} C400 ${40 + i * 40} 700 200 1200 200`} pathLength="1" style={`--i:${i}`} />
      ))}
    </svg>
    <p class="closing__kicker" data-reveal>{kicker}</p>
    <h2 class="closing__title" data-reveal style="--d:1">{title}</h2>
    <p class="closing__text" data-reveal style="--d:2">{text}</p>
    <div class="closing__actions" data-reveal style="--d:3">
      <a class="btn btn--light" href={DIAGNOSIS_MAILTO}>
        Solicitar diagnóstico <span class="sr-only">(abre su programa de correo)</span> <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <span class="closing__mail">o escríbanos a <a href={`mailto:${EMAIL}`}>{EMAIL}</a></span>
    </div>
    <p class="closing__privacy" data-reveal style="--d:4">
      Protección de datos: {holder()} tratará los datos que nos envíe solo para responder a su solicitud.
      Puede ejercer sus derechos de acceso, rectificación, supresión y demás escribiendo a ese mismo correo.
      Más información en la <a href={url('legal/privacidad')}>política de privacidad</a>.
    </p>
  </div>
</section>



<style>
  .closing {
    --focus: var(--gold-300);
    position: relative;
    background: var(--green-800);
    color: var(--cream-50);
    overflow: hidden;
  }
  .closing__inner {
    position: relative;
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .closing__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
    pointer-events: none;
  }
  .closing__lines path {
    fill: none;
    stroke: var(--green-600);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 0.25 0.75;
    animation: drift 14s linear infinite;
    animation-delay: calc(var(--i) * -1.4s);
  }
  @keyframes drift {
    to {
      stroke-dashoffset: -1;
    }
  }
  .closing__kicker {
    position: relative;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .closing__title {
    position: relative;
    margin-top: 1.5rem;
    max-width: 52rem;
    font-size: clamp(2.4rem, 5.5vw, 4.75rem);
    font-weight: 300;
  }
  .closing__text {
    position: relative;
    margin-top: 1.75rem;
    max-width: 38rem;
    color: var(--green-300);
    font-size: 1.1rem;
  }
  .closing__actions {
    position: relative;
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .closing__mail {
    color: var(--green-300);
    overflow-wrap: anywhere;
  }
  .closing__mail a {
    color: var(--cream-50);
    text-underline-offset: 3px;
  }
  .closing__privacy {
    position: relative;
    margin-top: 2.5rem;
    max-width: 44rem;
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--green-300);
  }
  .closing__privacy a {
    color: var(--cream-50);
    text-underline-offset: 3px;
  }

</style>
