---
import { DIAGNOSIS_MAILTO } from '../consts';

---
<section class="closing">
  <div class="container closing__inner">
    <svg class="closing__lines" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
      {Array.from({ length: 9 }, (_, i) => (
        <path d={`M0 ${40 + i * 40} C400 ${40 + i * 40} 700 200 1200 200`} pathLength="1" style={`--i:${i}`} />
      ))}
    </svg>
    <p class="closing__kicker" data-reveal>Primer paso</p>
    <h2 class="closing__title" data-reveal style="--d:1">
      Hablemos de la decisión que hoy le quita más tiempo.
    </h2>
    <p class="closing__text" data-reveal style="--d:2">
      Una primera conversación para entender su organización, sus decisiones críticas y el estado real de
      su información. Sin coste ni compromiso.
    </p>
    <div class="closing__actions" data-reveal style="--d:3">
      <a class="btn btn--light" href={DIAGNOSIS_MAILTO}>
        Solicitar diagnóstico <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <span class="closing__note">Sesión inicial sin coste</span>
    </div>
  </div>
</section>



<style>
  .closing {
    position: relative;
    background: var(--green-800);
    color: var(--cream-50);
    overflow: hidden;
  }
  .closing__inner {
    position: relative;
    padding-block: clamp(6rem, 12vw, 10rem);
  }
  .closing__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.35;
    pointer-events: none;
  }
  .closing__lines path {
    fill: none;
    stroke: var(--green-600);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 0.25 0.75;
    animation: drift 14s linear infinite;
    animation-delay: calc(var(--i) * -1.4s);
  }
  @keyframes drift {
    to {
      stroke-dashoffset: -1;
    }
  }
  .closing__kicker {
    position: relative;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .closing__title {
    position: relative;
    margin-top: 1.5rem;
    max-width: 52rem;
    font-size: clamp(2.4rem, 5.5vw, 4.75rem);
    font-weight: 300;
  }
  .closing__text {
    position: relative;
    margin-top: 1.75rem;
    max-width: 38rem;
    color: var(--green-300);
    font-size: 1.1rem;
  }
  .closing__actions {
    position: relative;
    margin-top: 2.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .closing__note {
    font-size: 0.85rem;
    color: var(--green-300);
  }

</style>
