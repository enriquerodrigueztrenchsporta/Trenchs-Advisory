---
import Logo from './Logo.astro';
import { EMAIL, url } from '../consts';
import { SERVICES, FIRMA_NAV } from '../data/services';
import { holder } from '../data/legal';

const legal = [
  { name: 'Aviso legal y condiciones de uso', path: 'legal/aviso-legal' },
  { name: 'Política de privacidad', path: 'legal/privacidad' },
  { name: 'Política de cookies', path: 'legal/cookies' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo inverse />
      <p>Decisiones más inteligentes.<br />Organizaciones más competitivas.</p>
    </div>
    <nav class="footer__col" aria-label="Servicios">
      <span class="footer__title">Servicios</span>
      {SERVICES.map((s) => <a href={url(`servicios/${s.slug}`)}>{s.name}</a>)}
    </nav>
    <nav class="footer__col" aria-label="La firma">
      <span class="footer__title">La firma</span>
      {FIRMA_NAV.map((f) => <a href={url(f.path)}>{f.name}</a>)}
    </nav>
    <div class="footer__col">
      <span class="footer__title">Contacto</span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </div>
  </div>
  <div class="container footer__legal">
    <span>© {year} {holder()}</span>
    <nav class="footer__legal-nav" aria-label="Información legal">
      {legal.map((l) => <a href={url(l.path)}>{l.name}</a>)}
    </nav>
    <button class="footer__motion" type="button" aria-pressed="false" data-motion-toggle>
      Pausar animaciones
    </button>
  </div>
</footer>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  if (btn) {
    const root = document.documentElement;
    const render = () => {
      const paused = root.classList.contains('motion-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Reanudar animaciones' : 'Pausar animaciones';
    };
    render();
    btn.addEventListener('click', () => {
      const paused = root.classList.toggle('motion-paused');
      try {
        if (paused) localStorage.setItem('motion', 'paused');
        else localStorage.removeItem('motion');
      } catch {}
      document.dispatchEvent(new CustomEvent('motionchange', { detail: { paused } }));
      render();
    });
  }
</script>

<style>
  .footer {
    --focus: var(--gold-300);
    background: var(--green-900);
    color: var(--green-300);
    font-size: 0.9rem;
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 4rem 3rem;
  }
  .footer__brand p {
    margin-top: 1.5rem;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--cream-50);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .footer__title {
    margin-bottom: 0.3rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }
  .footer a {
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.3s var(--ease);
  }
  .footer a:hover {
    color: var(--cream-50);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid rgb(245 243 238 / 0.12);
    font-size: 0.8rem;
  }
  .footer__legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .footer__legal-nav a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer__motion {
    margin-left: auto;
    padding: 0.35rem 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .footer__motion:hover {
    color: var(--cream-50);
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
