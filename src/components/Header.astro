---
import Logo from './Logo.astro';
import { DIAGNOSIS_MAILTO, url } from '../consts';
import { SERVICES, FIRMA_NAV } from '../data/services';

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (path: string) => current === url(path).replace(/\/$/, '');
const inServices = current.includes('/servicios/');
const inFirma = current.includes('/firma/');

const menus = [
  {
    id: 'servicios',
    label: 'Servicios',
    active: inServices,
    feature: {
      kicker: 'Cinco áreas, una lógica',
      text: 'El producto no es la herramienta. El producto es la capacidad de decisión.',
    },
    items: SERVICES.map((s, i) => ({
      name: s.name,
      subtitle: s.subtitle,
      href: url(`servicios/${s.slug}`),
      num: `0${i + 1}`,
      active: isActive(`servicios/${s.slug}`),
    })),
  },
  {
    id: 'firma',
    label: 'La firma',
    active: inFirma,
    feature: {
      kicker: 'Trenchs Advisory',
      text: 'Estrategia, finanzas, datos y tecnología, integrados para decidir mejor.',
    },
    items: FIRMA_NAV.map((f, i) => ({
      name: f.name,
      subtitle: f.subtitle,
      href: url(f.path),
      num: `0${i + 1}`,
      active: isActive(f.path),
    })),
  },
];
---
<header class="header" data-header>
  <div class="container header__inner">
    <Logo />
    <nav class="nav" id="nav" aria-label="Principal">
      <ul class="nav__list">
        {menus.map((m) => (
          <li class="dd" data-dd>
            <button
              class:list={['nav__link', 'dd__trigger', { 'is-active': m.active }]}
              type="button"
              aria-expanded="false"
              aria-controls={`dd-${m.id}`}
            >
              {m.label}
              <svg class="dd__chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
            </button>
            <div class="dd__panel" id={`dd-${m.id}`}>
              <div class="dd__inner">
                <div class="dd__feature">
                  <span class="dd__kicker">{m.feature.kicker}</span>
                  <p>{m.feature.text}</p>
                </div>
                <ul class="dd__items">
                  {m.items.map((it) => (
                    <li>
                      <a class:list={['dd__item', { 'is-active': it.active }]} href={it.href} aria-current={it.active ? 'page' : undefined}>
                        <span class="dd__num">{it.num}</span>
                        <span class="dd__text">
                          <span class="dd__name">{it.name}</span>
                          <span class="dd__sub">{it.subtitle}</span>
                        </span>
                        <span class="dd__arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <a class="btn btn--small nav__cta" href={DIAGNOSIS_MAILTO}>
        Solicitar diagnóstico <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu-btn>
      <span class="sr-only">Abrir menú</span>
      <span class="menu-btn__bar"></span>
      <span class="menu-btn__bar"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const dds = [...header.querySelectorAll<HTMLElement>('[data-dd]')];

  const onScroll = () => header.classList.toggle('is-compact', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setDropdown = (dd: HTMLElement, open: boolean) => {
    dd.classList.toggle('is-open', open);
    dd.querySelector('.dd__trigger')!.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except?: HTMLElement) => dds.forEach((d) => d !== except && setDropdown(d, false));

  dds.forEach((dd) => {
    const trigger = dd.querySelector<HTMLButtonElement>('.dd__trigger')!;
    trigger.addEventListener('click', () => {
      const open = !dd.classList.contains('is-open');
      closeAll(dd);
      setDropdown(dd, open);
    });
    // Con ratón: abrir al pasar por encima, con un pequeño margen al salir.
    let leaveTimer: number | undefined;
    dd.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse' || header.classList.contains('is-open')) return;
      window.clearTimeout(leaveTimer);
      closeAll(dd);
      setDropdown(dd, true);
    });
    dd.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || header.classList.contains('is-open')) return;
      leaveTimer = window.setTimeout(() => setDropdown(dd, false), 160);
    });
  });

  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) closeAll();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = dds.find((d) => d.classList.contains('is-open'));
    if (open) {
      setDropdown(open, false);
      open.querySelector<HTMLButtonElement>('.dd__trigger')!.focus();
    } else if (header.classList.contains('is-open')) {
      setMenu(false);
      btn.focus();
    }
  });

  const setMenu = (open: boolean) => {
    header.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) closeAll();
  };
  btn.addEventListener('click', () => setMenu(!header.classList.contains('is-open')));
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 5.5rem;
    transition: height 0.4s var(--ease);
  }
  .header.is-compact,
  .header:has(.dd.is-open) {
    background: color-mix(in srgb, var(--cream-50) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .header.is-compact .header__inner {
    height: 4.25rem;
  }
  .header__inner > :global(.logo) {
    position: relative;
    z-index: 2;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }
  .nav__list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.93rem;
    color: var(--ink);
    cursor: pointer;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.3rem;
    height: 1px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease);
  }
  .nav__link.is-active::after,
  .dd.is-open .nav__link::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .dd__chev {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    transition: transform 0.35s var(--ease);
  }
  .dd.is-open .dd__chev {
    transform: rotate(180deg);
  }

  /* Panel desplegable (escritorio) */
  .dd__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    padding-top: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--ease),
      visibility 0.35s;
  }
  .dd.is-open .dd__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .dd__inner {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 2.5rem var(--gutter) 2.75rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 5rem);
    background: var(--cream-50);
    border-top: 1px solid var(--line);
    box-shadow: 0 30px 60px -30px rgb(31 58 51 / 0.25);
  }
  .dd__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cream-50);
    z-index: -1;
  }
  .dd__kicker {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-500);
  }
  .dd__feature p {
    margin-top: 1rem;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.2;
    color: var(--green-900);
  }
  .dd__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
  }
  .dd__item {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: start;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
  }
  .dd.is-open .dd__item {
    opacity: 1;
    transform: none;
  }
  .dd__items li:nth-child(2) .dd__item { transition-delay: 40ms; }
  .dd__items li:nth-child(3) .dd__item { transition-delay: 80ms; }
  .dd__items li:nth-child(4) .dd__item { transition-delay: 120ms; }
  .dd__items li:nth-child(5) .dd__item { transition-delay: 160ms; }
  .dd__num {
    font-size: 0.72rem;
    color: var(--gold-500);
    padding-top: 0.3rem;
  }
  .dd__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dd__name {
    font-family: var(--serif);
    font-size: 1.3rem;
    line-height: 1.15;
    transition: color 0.3s var(--ease);
  }
  .dd__sub {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .dd__arrow {
    color: var(--gold-500);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .dd__item:hover .dd__name,
  .dd__item.is-active .dd__name {
    color: var(--green-600);
  }
  .dd__item:hover .dd__arrow,
  .dd__item.is-active .dd__arrow {
    opacity: 1;
    transform: none;
  }

  .menu-btn {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Móvil: menú a pantalla completa con acordeones */
  @media (max-width: 960px) {
    /* backdrop-filter convierte la cabecera en contenedor de los fixed: se quita con el menú abierto */
    .header.is-open,
    .header.is-open:has(.dd.is-open) {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--cream-50);
    }
    .menu-btn {
      display: grid;
      place-content: center;
      gap: 7px;
      width: 2.75rem;
      height: 2.75rem;
      background: none;
      border: 0;
      cursor: pointer;
      position: relative;
      z-index: 2;
    }
    .menu-btn__bar {
      display: block;
      width: 1.5rem;
      height: 1.5px;
      background: var(--ink);
      transition: transform 0.4s var(--ease);
    }
    .header.is-open .menu-btn__bar:first-of-type {
      transform: translateY(4.25px) rotate(45deg);
    }
    .header.is-open .menu-btn__bar:last-of-type {
      transform: translateY(-4.25px) rotate(-45deg);
    }
    .nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 2.5rem;
      padding: 6.5rem var(--gutter) 3rem;
      background: var(--cream-50);
      overflow-y: auto;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.4s var(--ease),
        visibility 0.4s;
    }
    .header.is-open .nav {
      opacity: 1;
      visibility: visible;
    }
    .nav__list {
      flex-direction: column;
      gap: 0;
    }
    .dd {
      border-bottom: 1px solid var(--line);
    }
    .nav__link {
      width: 100%;
      justify-content: space-between;
      padding: 1.1rem 0;
      font-family: var(--serif);
      font-size: 2rem;
      font-weight: 350;
    }
    .nav__link::after {
      display: none;
    }
    .dd__chev {
      width: 1rem;
      height: 1rem;
    }
    .dd__panel {
      position: static;
      display: grid;
      grid-template-rows: 0fr;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: grid-template-rows 0.45s var(--ease);
    }
    .dd__panel::before {
      display: none;
    }
    .dd.is-open .dd__panel {
      grid-template-rows: 1fr;
    }
    .dd__inner {
      min-height: 0;
      overflow: hidden;
      display: block;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }
    .dd__feature {
      display: none;
    }
    .dd__items {
      grid-template-columns: 1fr;
      padding-bottom: 1rem;
    }
    .dd__name {
      font-size: 1.15rem;
    }
    .nav__cta {
      align-self: flex-start;
    }
  }
</style>
